{
    "name": "aldytoi/laravel-toi",
    "type": "library",
    "description": "Laravel 12 starter kit with authentication, admin dashboard, Tailwind CSS, and Lucide Icons.",
    "keywords": ["laravel", "starter-kit", "boilerplate", "auth", "tailwind", "lucide"],
    "homepage": "https://github.com/aldytoi/laravel-toi",
    "license": "MIT",
    "authors": [
        {
            "name": "Aldytoi",
            "email": "aldyjrz@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0",
        "illuminate/support": "^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Aldytoi\\LaravelToi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aldytoi\\LaravelToi\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aldytoi\\LaravelToi\\LaravelToiServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
